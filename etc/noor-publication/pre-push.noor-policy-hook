#!/bin/sh
set -eu
set -f
LC_ALL=C

# Noor Personal publication-control v6 gate (permanent generic template).
# Installed verbatim into .git/hooks/pre-push by install-hook.sh.
# This template is the canonical hook policy for the publication-control
# mechanism. It contains no per-publication commit hashes; all
# per-publication values are read from active.gate.

# Permanent constants (not per-publication):
CANONICAL_URL='https://github.com/engaboali9226-mastoura/noor-platform.git'
CANONICAL_REPOSITORY='engaboali9226-mastoura/noor-platform'
CANONICAL_REPOSITORY_ID=1284723703
PROTECTED_REF='refs/heads/product/noor-personal-mvp'
ZERO_OBJECT='0000000000000000000000000000000000000000'
HOOK_POLICY_VERSION='6'
SCHEMA_VERSION='3'
GATE_FILE_LINES=14
PUB_RE='refs/heads/pub/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]'
GATE_DIR_NAME='noor-publication-gate'
CONSUMED_DIR_NAME='consumed'
BACKUP_DIR_NAME='backups'
REVOKED_DIR_NAME='revoked'
STATE_LOCK_NAME='state.lock'
ACTIVE_GATE_NAME='active.gate'
AUDIT_LOG_NAME='audit.log'
SENTINEL_URL='no_push://noor-personal-dev'

deny() {
    echo "Push blocked: Noor Personal publication-control v6 gate." >&2
    echo "Push denied: $1." >&2
    exit 1
}

verify_repository_identity() {
    # Disable user curl configuration and refuse to follow even one redirect.
    response=$(curl --disable --silent --show-error --fail --location --max-redirs 0 \
        --proto '=https' --proto-redir '=https' --connect-timeout 5 --max-time 15 \
        --header 'Accept: application/vnd.github+json' \
        --write-out '\n%{http_code}' \
        "https://api.github.com/repos/$CANONICAL_REPOSITORY") ||
        deny "canonical repository identity is unavailable"
    status=$(printf '%s\n' "$response" | tail -n 1)
    [ "$status" = 200 ] || deny "canonical repository did not give a direct HTTP 200"
    printf '%s\n' "$response" | sed '$d' |
        jq -es --arg name "$CANONICAL_REPOSITORY" --arg url "$CANONICAL_URL" \
            --argjson id "$CANONICAL_REPOSITORY_ID" \
            'length == 1 and (.[0] | type == "object" and .id == $id and .full_name == $name and .clone_url == $url)' \
            >/dev/null || deny "canonical repository identity mismatch"
}

if [ "$#" -eq 1 ] && [ "$1" = '--check-identity' ]; then
    verify_repository_identity
    exit 0
fi

# Inspect the config loaded by Git, including conditional includes. Fail closed
# on a read error and never include configuration values in diagnostics.
deny_config_entries() {
    if git config --includes --name-only --get-regexp "$1" >/dev/null 2>&1; then
        deny "$2"
    else
        [ "$?" -eq 1 ] || deny "cannot inspect Git configuration"
    fi
}

check_persistent_hook_config() {
    git config --includes --list >/dev/null 2>&1 || deny "cannot read Git configuration"
    deny_config_entries '^hook\.' "configured Git hooks are not supported"
}

check_persistent_transport_config() (
    unset GIT_CONFIG_COUNT
    check_persistent_hook_config
    deny_config_entries '^url\..*\.(insteadof|pushinsteadof)$' "Git URL rewrite is not supported"
    deny_config_entries '^http\..+\.[^.]+$' "URL-scoped HTTP configuration is not supported"
    deny_config_entries '^http\.(proxy|extraheader|curloptresolve)$' "HTTP transport override is not supported"
    deny_config_entries '^remote\.https://github\.com/engaboali9226-mastoura/noor-platform\.git\.' "canonical URL used as configured remote name"
    deny_config_entries '^core\.hookspath$' "custom core.hooksPath is not supported"

    if tls_verify=$(git config --type=bool --get http.sslVerify 2>/dev/null); then
        [ "$tls_verify" = true ] || deny "HTTPS certificate verification must stay enabled"
    else
        [ "$?" -eq 1 ] || deny "cannot inspect HTTPS certificate verification"
    fi
)

check_config_environment() {
    [ -z "${GIT_CONFIG+x}${GIT_CONFIG_PARAMETERS+x}${GIT_SSL_NO_VERIFY+x}" ] ||
        deny "inherited Git config or TLS override is not supported"
}

check_canonical_push_context() {
    check_config_environment
    if [ -n "${GIT_CONFIG_COUNT+x}" ]; then
        # Accept only the exact settings installed by the transport on its
        # push invocation. Unset them only for persistent config inspection.
        [ "$GIT_CONFIG_COUNT" = 3 ] &&
            [ "${GIT_CONFIG_KEY_0-}" = http.followRedirects ] && [ "${GIT_CONFIG_VALUE_0-}" = false ] &&
            [ "${GIT_CONFIG_KEY_1-}" = http.sslVerify ] && [ "${GIT_CONFIG_VALUE_1-}" = true ] &&
            [ "${GIT_CONFIG_KEY_2-}" = core.hooksPath ] &&
            [ "${GIT_CONFIG_VALUE_2-}" = "$COMMON_DIR/hooks" ] ||
            deny "inherited Git config override is not supported"
    fi
    check_persistent_transport_config

    redirect_policy=$(git config --type=bool --get-urlmatch http.followRedirects "$CANONICAL_URL" 2>/dev/null) ||
        deny "HTTPS redirects must be disabled before the push"
    [ "$redirect_policy" = false ] || deny "HTTPS redirects must be disabled before the push"
}

if [ "$#" -eq 1 ]; then
    case "$1" in
        --check-configured-hooks|--preflight-transport)
            check_config_environment
            [ -z "${GIT_CONFIG_COUNT+x}" ] || deny "inherited Git config override is not supported"
            if [ "$1" = '--check-configured-hooks' ]; then
                check_persistent_hook_config
            else
                check_persistent_transport_config
                verify_repository_identity
            fi
            exit 0
            ;;
    esac
fi

# SHA-256 utility with capability detection (macOS / GNU).
# Accepts an optional file argument; with no argument, hashes stdin.
compute_sha256() {
    if [ "$#" -gt 0 ] && [ -n "$1" ]; then
        if command -v sha256sum >/dev/null 2>&1; then
            sha256sum "$1" | awk '{print $1}'
        elif command -v shasum >/dev/null 2>&1; then
            shasum -a 256 "$1" | awk '{print $1}'
        else
            return 127
        fi
    else
        if command -v sha256sum >/dev/null 2>&1; then
            sha256sum | awk '{print $1}'
        elif command -v shasum >/dev/null 2>&1; then
            shasum -a 256 | awk '{print $1}'
        else
            return 127
        fi
    fi
}

# POSIX-compatible first-12-char extraction (no Bash substring expansion)
first12() {
    printf '%s' "$1" | cut -c1-12
}

# Acquire common state lock (same lock used by generate-gate.sh,
# publish-once.sh, and revoke-gate.sh).
acquire_lock() {
    LOCK_DIR="$GATE_DIR/$STATE_LOCK_NAME"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        deny "state lock is held; a concurrent operation is in progress or a previous lock was not recovered"
    fi
    trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' 0 1 2 3 15
}

# Validate gate file bytes and schema.
validate_gate() {
    [ -f "$ACTIVE_GATE" ] || deny "active.gate is unavailable"
    [ ! -L "$ACTIVE_GATE" ] || deny "active.gate is a symlink"
    [ "$(stat -f '%u' "$ACTIVE_GATE")" = "$(id -u)" ] || deny "gate owner invalid"
    [ "$(stat -f '%Lp' "$ACTIVE_GATE")" = 600 ] || deny "gate mode invalid"
    [ "$(stat -f '%l' "$ACTIVE_GATE")" = 1 ] || deny "gate link count invalid"

    # Line count: exactly 14 newlines
    lc=$(wc -l < "$ACTIVE_GATE" | tr -d ' ')
    [ "$lc" -eq "$GATE_FILE_LINES" ] || deny "gate line count is invalid"

    # Final byte must be LF (0a)
    fb=$(tail -c 1 "$ACTIVE_GATE" | od -An -t x1 | tr -d ' \n')
    [ "$fb" = "0a" ] || deny "gate final LF missing"

    # No non-printable-ASCII characters (catches NUL, CR, control chars, high bytes)
    if LC_ALL=C grep -q '[^ -~]' "$ACTIVE_GATE"; then
        deny "gate contains invalid control characters"
    fi

    # No CRLF (CR is caught above, but explicit check for clarity)
    if grep -q "$(printf '\r')" "$ACTIVE_GATE"; then
        deny "gate contains CRLF line endings"
    fi

    # Parse and validate each line in order
    line_no=0
    while IFS= read -r line || [ -n "$line" ]; do
        line_no=$((line_no + 1))
        [ "$line_no" -le 14 ] || deny "gate has extra fields"
        case "$line_no" in
            1)  [ "$line" = "SCHEMA_VERSION=3" ] || deny "schema version invalid" ;;
            2)  v=${line#REPOSITORY_URL=}
                [ "$line" = "REPOSITORY_URL=$v" ] || deny "field 2 malformed"
                [ "$v" = "$CANONICAL_URL" ] || deny "repository URL mismatch" ;;
            3)  v=${line#SOURCE_REF=}
                [ "$line" = "SOURCE_REF=$v" ] || deny "field 3 malformed"
                if [ "$v" != "(delete)" ]; then
                    git check-ref-format "$v" || deny "source ref invalid"
                fi
                SRC_REF_GATE="$v" ;;
            4)  v=${line#SOURCE_OBJECT=}
                [ "$line" = "SOURCE_OBJECT=$v" ] || deny "field 4 malformed"
                printf '%s' "$v" | grep -Eq '^[0-9a-f]{40}$' || deny "source object format invalid"
                SRC_OBJ_GATE="$v" ;;
            5)  v=${line#DESTINATION_REF=}
                [ "$line" = "DESTINATION_REF=$v" ] || deny "field 5 malformed"
                git check-ref-format "$v" || deny "destination ref invalid"
                DST_REF_GATE="$v" ;;
            6)  v=${line#REQUIRED_REMOTE_OBJECT=}
                [ "$line" = "REQUIRED_REMOTE_OBJECT=$v" ] || deny "field 6 malformed"
                printf '%s' "$v" | grep -Eq '^[0-9a-f]{40}$' || deny "required remote object format invalid"
                REQ_REMOTE_OBJ_GATE="$v" ;;
            7)  [ "$line" = "UPDATE_COUNT=1" ] || deny "update count invalid" ;;
            8)  v=${line#OPERATION=}
                [ "$line" = "OPERATION=$v" ] || deny "field 8 malformed"
                [ "$v" = "CREATE_NON_PROTECTED_BRANCH_EXACT_OBJECT" ] || \
                [ "$v" = "UPDATE_NON_PROTECTED_BRANCH_FAST_FORWARD" ] || \
                [ "$v" = "CREATE_ANNOTATED_TAG_EXACT_OBJECT" ] || \
                [ "$v" = "DELETE_NON_PROTECTED_BRANCH_EXACT_OBJECT" ] || \
                    deny "operation invalid"
                OP_GATE="$v" ;;
            9)  v=${line#CREATED_AT=}
                [ "$line" = "CREATED_AT=$v" ] || deny "field 9 malformed"
                printf '%s' "$v" | grep -Eq '^[0-9]{10}$' || deny "created timestamp malformed"
                CREATED_GATE="$v" ;;
            10) v=${line#EXPIRES_AT=}
                [ "$line" = "EXPIRES_AT=$v" ] || deny "field 10 malformed"
                printf '%s' "$v" | grep -Eq '^[0-9]{10}$' || deny "expires timestamp malformed"
                EXPIRES_GATE="$v" ;;
            11) v=${line#NONCE=}
                [ "$line" = "NONCE=$v" ] || deny "field 11 malformed"
                printf '%s' "$v" | grep -Eq '^[0-9a-f]{32}$' || deny "nonce format invalid"
                NONCE_GATE="$v" ;;
            12) v=${line#AUTHORITY_ID=}
                [ "$line" = "AUTHORITY_ID=$v" ] || deny "field 12 malformed"
                printf '%s' "$v" | grep -Eq '^[A-Z0-9][A-Z0-9._-]{0,126}$' || deny "authority_id format invalid"
                AUTH_GATE="$v" ;;
            13) [ "$line" = "HOOK_POLICY_VERSION=6" ] || deny "hook policy version mismatch" ;;
            14) v=${line#GATE_FILE_SHA256=}
                [ "$line" = "GATE_FILE_SHA256=$v" ] || deny "field 14 malformed"
                printf '%s' "$v" | grep -Eq '^[0-9a-f]{64}$' || deny "sha256 format invalid"
                GATESHA_GATE="$v" ;;
        esac
    done < "$ACTIVE_GATE"
    [ "$line_no" -eq 14 ] || deny "gate is incomplete"

    # Integrity check: SHA-256 of lines 1-13 must equal field 14
    computed=$(head -13 "$ACTIVE_GATE" | compute_sha256)
    [ "$computed" = "$GATESHA_GATE" ] || deny "gate integrity check failed"

    # Time window
    now=$(date -u '+%s')
    now_10=$(printf '%s' "$now" | grep -Eq '^[0-9]{10}$' && printf '%s' "$now" || printf '0000000000')
    [ "$CREATED_GATE" -le "$now" ] || deny "gate not yet valid"
    [ "$now" -lt "$EXPIRES_GATE" ] || deny "gate expired"
    ttl=$((EXPIRES_GATE - CREATED_GATE))
    [ "$ttl" -ge 1 ] || deny "gate TTL too short"
    [ "$ttl" -le 86400 ] || deny "gate TTL exceeds maximum"
}

# Main hook entry
# Canonical remote identity is enforced fail-closed: ONLY the exact canonical
# repository URL grants publication authority. No url.*.insteadOf mapping, local
# path, alias, or config-controlled replacement is ever treated as an equivalent
# to the canonical repository URL. The canonical URL is a compile-time constant.
check_gate_only=0
if [ "$#" -eq 1 ] && [ "$1" = '--check-gate' ]; then
    check_gate_only=1
else
    [ "$#" -eq 2 ] || deny "remote arguments invalid"
    [ "$2" = "$CANONICAL_URL" ] || deny "remote URL is not authorized: publishing requires the exact canonical repository URL"
    [ "${GIT_PUSH_OPTION_COUNT-}" = "" ] || [ "${GIT_PUSH_OPTION_COUNT-}" = "0" ] ||
        deny "push options not authorized"
fi

# Resolve the same common directory as the publisher before inspecting config.
COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
    deny "cannot resolve the common Git directory"
if [ "$check_gate_only" -eq 0 ]; then
    check_canonical_push_context
fi

# Verify persistent push URL sentinel is intact.
configured_pushurl=$(git remote get-url --push --all origin 2>/dev/null && printf '.') ||
    deny "cannot resolve effective origin push URLs"
[ "$configured_pushurl" = "$(printf '%s\n.' "$SENTINEL_URL")" ] ||
    deny "persistent push URL sentinel has been altered"

GATE_DIR=$COMMON_DIR/$GATE_DIR_NAME
CONSUMED_DIR=$GATE_DIR/$CONSUMED_DIR_NAME
REVOKED_DIR=$GATE_DIR/$REVOKED_DIR_NAME
ACTIVE_GATE=$GATE_DIR/$ACTIVE_GATE_NAME

# Directory validation
[ -d "$GATE_DIR" ] && [ ! -L "$GATE_DIR" ] || deny "gate directory invalid"
[ -d "$CONSUMED_DIR" ] && [ ! -L "$CONSUMED_DIR" ] || deny "consumed directory invalid"
[ -d "$REVOKED_DIR" ] && [ ! -L "$REVOKED_DIR" ] || deny "revoked directory invalid"
[ "$(stat -f '%u' "$GATE_DIR")" = "$(id -u)" ] || deny "gate dir owner invalid"
[ "$(stat -f '%Lp' "$GATE_DIR")" = 700 ] || deny "gate dir mode invalid"

# For the read-only preflight the publisher already holds state.lock.
if [ "$check_gate_only" -eq 0 ]; then
    acquire_lock
fi
validate_gate

# Archived authorization identifiers stay reserved across all policy versions.
CONSUMED_GATE=$CONSUMED_DIR/$NONCE_GATE.gate
REVOKED_GATE=$REVOKED_DIR/$NONCE_GATE.gate
[ ! -e "$CONSUMED_GATE" ] && [ ! -L "$CONSUMED_GATE" ] || deny "nonce already consumed"
[ ! -e "$REVOKED_GATE" ] && [ ! -L "$REVOKED_GATE" ] || deny "nonce already revoked"
[ "$check_gate_only" -eq 0 ] || exit 0

# Bind the exact gate selected by publish-once under its lock.
[ "${NOOR_PUBLICATION_GATE_NONCE-}" = "$NONCE_GATE" ] ||
    deny "active gate nonce differs from publication request"
gate_sha=$(compute_sha256 "$ACTIVE_GATE")
[ "${NOOR_PUBLICATION_GATE_SHA256-}" = "$gate_sha" ] &&
    printf '%s\n' "$gate_sha" | grep -Eq '^[0-9a-f]{64}$' ||
    deny "active gate SHA-256 differs from publication request"

# Read and validate stdin ref updates (exactly one)
update_count=0
while IFS= read -r line || [ -n "$line" ]; do
    update_count=$((update_count + 1))
    [ "$update_count" -eq 1 ] || deny "multiple ref updates not authorized"
    [ -n "$line" ] || deny "ref update line empty"
    set -- $line
    [ "$#" -eq 4 ] || deny "ref update malformed"
    local_ref=$1
    local_object=$2
    remote_ref=$3
    remote_object=$4
done
[ "$update_count" -eq 1 ] || deny "exactly one ref update required"

# Validate against gate
[ "$local_ref" = "$SRC_REF_GATE" ] || deny "source ref mismatch"
[ "$local_object" = "$SRC_OBJ_GATE" ] || deny "source object mismatch"
[ "$remote_ref" = "$DST_REF_GATE" ] || deny "destination ref mismatch"

# Reject zero local object for non-delete operations
if [ "$OP_GATE" != "DELETE_NON_PROTECTED_BRANCH_EXACT_OBJECT" ]; then
    [ "$local_object" != "$ZERO_OBJECT" ] || deny "deletion rejected"
fi

legacy_nonpub_delete_pair_allowed() {
    case "$1|$2" in
        "refs/heads/codex/noor-ci-workspace-integration|9427b2574488a3a3b3144d7da63332cdabb9d0aa") return 0 ;;
        "refs/heads/codex/platform-app-catalog-foundation|3097814d5f2195c35d3308ff96c90abd149c1bd9") return 0 ;;
        "refs/heads/codex/platform-application-composition-foundation|68fa2995c5be8193a269edc45117d1adc6f6dcba") return 0 ;;
        "refs/heads/agents/workspace-package-entrypoint-contract-repair|7ab046ac2fe8fa89c4c1031bfead41dfa7aa4b6d") return 0 ;;
    esac
    return 1
}

# Operation-specific checks
case "$OP_GATE" in
    CREATE_NON_PROTECTED_BRANCH_EXACT_OBJECT)
        [ "$REQ_REMOTE_OBJ_GATE" = "$ZERO_OBJECT" ] || deny "CREATE requires zero remote object"
        [ "$remote_object" = "$ZERO_OBJECT" ] || deny "CREATE requires remote object is zero"
        ;;
    UPDATE_NON_PROTECTED_BRANCH_FAST_FORWARD)
        [ "$REQ_REMOTE_OBJ_GATE" != "$ZERO_OBJECT" ] || deny "UPDATE requires non-zero remote object"
        [ "$remote_object" = "$REQ_REMOTE_OBJ_GATE" ] || deny "remote object mismatch"
        git cat-file -e "$REQ_REMOTE_OBJ_GATE^{commit}" 2>/dev/null || deny "required remote object not a local commit"
        git merge-base --is-ancestor "$REQ_REMOTE_OBJ_GATE" "$SRC_OBJ_GATE" 2>/dev/null ||
            deny "update is not a fast-forward"
        ;;
    CREATE_ANNOTATED_TAG_EXACT_OBJECT)
        [ "$SRC_REF_GATE" = "$DST_REF_GATE" ] || deny "tag source and destination differ"
        case "$SRC_REF_GATE" in refs/tags/*) ;; *) deny "tag operation source is not a tag ref" ;; esac
        case "$DST_REF_GATE" in refs/tags/*) ;; *) deny "tag operation destination is not a tag ref" ;; esac
        [ "$REQ_REMOTE_OBJ_GATE" = "$ZERO_OBJECT" ] || deny "tag CREATE requires zero remote object"
        [ "$remote_object" = "$ZERO_OBJECT" ] || deny "tag CREATE requires remote object is zero"
        [ "$(git cat-file -t "$SRC_OBJ_GATE" 2>/dev/null || true)" = "tag" ] ||
            deny "source object is not an annotated tag"
        resolved_src=$(git rev-parse --verify "$SRC_REF_GATE" 2>/dev/null) || deny "source ref unavailable"
        [ "$resolved_src" = "$SRC_OBJ_GATE" ] || deny "source ref does not directly resolve to source object"
        tag_target=$(git cat-file -p "$SRC_OBJ_GATE" | sed -n '1s/^object //p')
        printf '%s' "$tag_target" | grep -Eq '^[0-9a-f]{40}$' || deny "annotated tag target is invalid"
        [ "$(git cat-file -t "$tag_target" 2>/dev/null || true)" = "commit" ] ||
            deny "annotated tag must directly target a commit"
        peeled_target=$(git rev-parse "$SRC_OBJ_GATE^{}" 2>/dev/null) || deny "annotated tag cannot be peeled"
        [ "$peeled_target" = "$tag_target" ] || deny "annotated tag peel does not match direct target"
        ;;
    DELETE_NON_PROTECTED_BRANCH_EXACT_OBJECT)
        [ "$SRC_REF_GATE" = "(delete)" ] || deny "delete operation source must be (delete)"
        [ "$SRC_OBJ_GATE" = "$ZERO_OBJECT" ] || deny "delete operation source object must be zero"
        [ "$REQ_REMOTE_OBJ_GATE" != "$ZERO_OBJECT" ] || deny "DELETE requires non-zero required remote object"
        case "$DST_REF_GATE" in refs/tags/*) deny "tag deletion not authorized by branch-delete operation" ;; esac
        case "$DST_REF_GATE" in refs/heads/*) ;; *) deny "delete operation destination is not a branch ref" ;; esac
        ;;
    *)
        deny "unknown operation"
        ;;
esac

case "$OP_GATE" in
    CREATE_NON_PROTECTED_BRANCH_EXACT_OBJECT|UPDATE_NON_PROTECTED_BRANCH_FAST_FORWARD)
        [ "$remote_ref" != "$PROTECTED_REF" ] || deny "protected branch rejected"
        case "$DST_REF_GATE" in refs/heads/pub/*) ;; *) deny "branch operation destination not in pub namespace" ;; esac
        actual_suffix=$(printf '%s' "$DST_REF_GATE" | sed 's|^refs/heads/pub/||')
        printf '%s' "$actual_suffix" | grep -Eq '^[0-9a-f]{12}$' || deny "destination suffix format invalid"
        git cat-file -e "$SRC_OBJ_GATE^{commit}" 2>/dev/null || deny "source object is not a commit"
        resolved_src=$(git rev-parse "$SRC_REF_GATE^{commit}" 2>/dev/null) || deny "source ref unavailable"
        [ "$resolved_src" = "$SRC_OBJ_GATE" ] || deny "source ref does not resolve to source object"
        if [ "$OP_GATE" = "CREATE_NON_PROTECTED_BRANCH_EXACT_OBJECT" ]; then
            expected_suffix=$(first12 "$SRC_OBJ_GATE")
            [ "$actual_suffix" = "$expected_suffix" ] || deny "destination suffix does not match source object"
        fi
        ;;
    DELETE_NON_PROTECTED_BRANCH_EXACT_OBJECT)
        [ "$remote_ref" != "$PROTECTED_REF" ] || deny "protected branch rejected"
        case "$DST_REF_GATE" in
            refs/heads/pub/*)
                actual_suffix=$(printf '%s' "$DST_REF_GATE" | sed 's|^refs/heads/pub/||')
                printf '%s' "$actual_suffix" | grep -Eq '^[0-9a-f]{12}$' || deny "destination suffix format invalid"
                ;;
            refs/heads/*)
                legacy_nonpub_delete_pair_allowed "$DST_REF_GATE" "$REQ_REMOTE_OBJ_GATE" ||
                    deny "delete operation destination not authorized by pub namespace or legacy exact allowlist"
                ;;
            *)
                deny "delete operation destination is not a branch ref"
                ;;
        esac
        ;;
esac

verify_repository_identity

# Remote read uses HTTPS only and the same redirect and TLS settings as the push.
remote_line=$(GIT_ALLOW_PROTOCOL=https git -c http.followRedirects=false -c http.sslVerify=true \
    ls-remote -- "$CANONICAL_URL" "$DST_REF_GATE" 2>/dev/null || deny "live remote check failed")

case "$OP_GATE" in
    CREATE_NON_PROTECTED_BRANCH_EXACT_OBJECT)
        [ -z "$remote_line" ] || deny "destination unexpectedly exists on remote"
        ;;
    UPDATE_NON_PROTECTED_BRANCH_FAST_FORWARD)
        set -- $remote_line
        [ "$#" -eq 2 ] || deny "live remote state malformed"
        [ "$1" = "$REQ_REMOTE_OBJ_GATE" ] || deny "live remote object mismatch"
        [ "$2" = "$DST_REF_GATE" ] || deny "live remote ref mismatch"
        ;;
    CREATE_ANNOTATED_TAG_EXACT_OBJECT)
        [ -z "$remote_line" ] || deny "destination unexpectedly exists on remote"
        ;;
    DELETE_NON_PROTECTED_BRANCH_EXACT_OBJECT)
        set -- $remote_line
        [ -n "$remote_line" ] || deny "remote branch already absent"
        [ "$#" -eq 2 ] || deny "live remote state malformed"
        [ "$1" = "$REQ_REMOTE_OBJ_GATE" ] || deny "live remote object mismatch"
        [ "$2" = "$DST_REF_GATE" ] || deny "live remote ref mismatch"
        ;;
esac

# Revalidate the original bytes immediately before taking ownership.
[ "$(compute_sha256 "$ACTIVE_GATE")" = "$gate_sha" ] ||
    deny "gate integrity changed during validation"

# Consume the gate only after the audit destination is safe.
audit_log="$GATE_DIR/$AUDIT_LOG_NAME"
[ ! -L "$audit_log" ] && { [ ! -e "$audit_log" ] || [ -f "$audit_log" ]; } ||
    deny "publication audit path is invalid"
mv "$ACTIVE_GATE" "$CONSUMED_GATE" || deny "gate consumption failed"

# Verify consumed gate metadata
[ -f "$CONSUMED_GATE" ] && [ ! -L "$CONSUMED_GATE" ] || deny "consumed artifact type invalid"
[ "$(stat -f '%u' "$CONSUMED_GATE")" = "$(id -u)" ] || deny "consumed owner invalid"
[ "$(stat -f '%Lp' "$CONSUMED_GATE")" = 600 ] || deny "consumed mode invalid"
[ "$(stat -f '%l' "$CONSUMED_GATE")" = 1 ] || deny "consumed link count invalid"
[ "$(compute_sha256 "$CONSUMED_GATE")" = "$gate_sha" ] ||
    deny "consumed artifact integrity changed"

# Record consumption (not network outcome)
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') event=AUTHORITY_CONSUMED_PRE_PUSH nonce=$NONCE_GATE op=$OP_GATE src=$SRC_REF_GATE@$SRC_OBJ_GATE dst=$DST_REF_GATE remote_obj=$REQ_REMOTE_OBJ_GATE authority=$AUTH_GATE hook_policy=$HOOK_POLICY_VERSION" >> "$GATE_DIR/$AUDIT_LOG_NAME"
chmod 0600 "$GATE_DIR/$AUDIT_LOG_NAME" 2>/dev/null || true

echo "Noor publication gate consumed; Git may attempt the authorized push."
exit 0
